NODE_ENV=development
PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/lavanet
MONGO_DB_NAME=lavanet
JWT_SECRET=change-me-to-a-long-random-string
JWT_COOKIE_EXPIRES_IN=7
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000

# Registro público (desactivado en producción)
ALLOW_PUBLIC_REGISTER=false

# Superadmin inicial (solo si no existe)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMeSuper2026!
SUPERADMIN_EMAIL=superadmin@lavanet.local

# Demo compartida
DEMO_USERNAME=demo
DEMO_PASSWORD=demo2026

# Billing: 61 días gratis + primer cobro; gracia 5 días; ciclo 30 días
BILLING_TRIAL_DAYS=61
BILLING_GRACE_DAYS=5
BILLING_CYCLE_DAYS=30

# Culqi (NUNCA commitear valores reales)
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
